generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  CI               Int      @id
  nombre           String
  apellido         String
  fecha_nacimiento DateTime
  direccion        String
  telefono         String
  email            String   @unique
  citas            Cita[]

  @@map("pacientes")
}

model Medico {
  id_medico       Int          @id @default(autoincrement())
  nombre          String
  apellido        String
  id_especialidad Int
  id_usuario      Int          @unique
  citas           Cita[]
  especialidad    Especialidad @relation(fields: [id_especialidad], references: [id_especialidad])
  usuario         Usuario      @relation(fields: [id_usuario], references: [id])

  @@map("medicos")
}

model Especialidad {
  id_especialidad Int      @id @default(autoincrement())
  nombre          String   @unique
  medicos         Medico[]

  @@map("especialidades")
}

model Cita {
  id_cita     Int        @id @default(autoincrement())
  fecha_hora  DateTime
  CI_paciente Int
  id_medico   Int
  estado      EstadoCita @default(PROGRAMADA)
  paciente    Paciente   @relation(fields: [CI_paciente], references: [CI])
  medico      Medico     @relation(fields: [id_medico], references: [id_medico])

  @@unique([id_medico, fecha_hora])
  @@unique([CI_paciente, fecha_hora])
  @@map("citas")
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String
  apellido String
  email    String  @unique
  password String
  rol      Rol
  medico   Medico?

  @@map("usuarios")
}

enum EstadoCita {
  PROGRAMADA
  COMPLETADA
  CANCELADA
}

enum Rol {
  RECEPCIONISTA
  MEDICO
  GERENCIA
}
